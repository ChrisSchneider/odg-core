#!/usr/bin/env bash
set -e

# Only act on staged Python files (added, copied, modified, renamed)
mapfile -d '' STAGED < <(git diff --cached --name-only -z --diff-filter=ACMR | grep -z '\.py$' || true)
if [ "${#STAGED[@]}" -eq 0 ]; then
    exit 0
fi

echo "pre-commit: applying ruff format..."
ruff format -- "${STAGED[@]}"

echo "pre-commit: running ruff lint (auto-fix)..."
ruff check --fix -- "${STAGED[@]}" || RUFF_STATUS=$?

# Re-stage any files that were just modified (even if lint has remaining violations)
git add -- "${STAGED[@]}"

exit "${RUFF_STATUS:-0}"
